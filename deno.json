{
  "tasks": {
    "dev": "deno task dev:daemon",
    "dev:daemon": "deno run --watch=apps/daemon/src,shared/src apps/daemon/src/main.ts __daemon-run",
    "dev:web": "deno run --watch=apps/web/src,shared/src apps/web/src/main.ts",
    "dev:cloud": "deno run --watch=apps/cloud/src,shared/src apps/cloud/src/main.ts",
    "dev:root": "deno run --watch main.ts",
    "fmt": "deno fmt deno.json main.ts main_test.ts apps shared tests",
    "fmt:check": "deno fmt --check deno.json main.ts main_test.ts apps shared tests",
    "lint": "deno lint main.ts main_test.ts apps shared tests",
    "check": "deno check main.ts main_test.ts apps/**/*.ts shared/**/*.ts tests/**/*.ts",
    "test": "deno test --parallel --allow-read --allow-write=.test-tmp --allow-env=KATO_LOGGING_OPERATIONAL_LEVEL,KATO_LOGGING_AUDIT_LEVEL,HOME,USERPROFILE,KATO_RUNTIME_DIR,KATO_DAEMON_STATUS_PATH,KATO_DAEMON_CONTROL_PATH,KATO_CLAUDE_SESSION_ROOTS,KATO_CODEX_SESSION_ROOTS,KATO_GEMINI_SESSION_ROOTS,KATO_DAEMON_MAX_MEMORY_MB,KATO_CONFIG_PATH,KATO_ALLOWED_WRITE_ROOT,KATO_ALLOWED_WRITE_ROOTS_JSON main_test.ts tests/**/*_test.ts",
    "test:coverage": "deno test --parallel --clean --coverage=.coverage --allow-read --allow-write=.test-tmp --allow-env=KATO_LOGGING_OPERATIONAL_LEVEL,KATO_LOGGING_AUDIT_LEVEL,HOME,USERPROFILE,KATO_RUNTIME_DIR,KATO_DAEMON_STATUS_PATH,KATO_DAEMON_CONTROL_PATH,KATO_CLAUDE_SESSION_ROOTS,KATO_CODEX_SESSION_ROOTS,KATO_GEMINI_SESSION_ROOTS,KATO_DAEMON_MAX_MEMORY_MB,KATO_CONFIG_PATH,KATO_ALLOWED_WRITE_ROOT,KATO_ALLOWED_WRITE_ROOTS_JSON main_test.ts tests/**/*_test.ts",
    "coverage:lcov": "deno coverage --lcov --output=coverage.lcov .coverage",
    "ci:quality": "deno task fmt --check && deno task lint && deno task check --frozen",
    "ci": "deno task fmt --check && deno task lint && deno task check --frozen && deno task test --frozen"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/cli": "jsr:@std/cli@1",
    "@std/path": "jsr:@std/path@1",
    "@std/yaml": "jsr:@std/yaml@1",
    "loglayer": "npm:loglayer@9.1.0",
    "@kato/shared": "./shared/src/mod.ts",
    "@kato/runtime": "./apps/runtime/src/mod.ts"
  },
  "fmt": {
    "exclude": ["dev-docs/notes/**", "**/*.md"]
  }
}
